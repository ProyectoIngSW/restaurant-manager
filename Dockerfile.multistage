# ==================================
# STAGE 1: Build
# ==================================
FROM maven:3.9.2-eclipse-temurin-17 AS builder

# Crear directorio de trabajo
WORKDIR /build

# Copiar pom.xml primero (para cachear dependencias)
COPY pom.xml .

# Descargar dependencias (esta capa se cachea)
RUN mvn dependency:go-offline -B

# Copiar código fuente
COPY src ./src

# Compilar la aplicación (sin tests para velocidad)
RUN mvn clean package -DskipTests -B

# ==================================
# STAGE 2: Runtime
# ==================================
FROM eclipse-temurin:17-jre-alpine

# Metadata
LABEL maintainer="tu-email@ejemplo.com"
LABEL description="Restaurant Manager - Optimized"
LABEL version="1.0"

# Crear usuario no-root (Alpine)
RUN addgroup -S appuser && adduser -S appuser -G appuser

# Crear directorio de trabajo
WORKDIR /app

# Copiar JAR desde stage de build
COPY --from=builder /build/target/restaurant-manager-*.jar app.jar

# Cambiar ownership
RUN chown -R appuser:appuser /app

# Cambiar a usuario no-root
USER appuser

# Exponer puerto
EXPOSE 8080

# Variables de entorno
ENV JAVA_OPTS="-Xmx256m -Xms128m -XX:+UseG1GC"

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
 CMD java -cp app.jar com.restaurant.manager.HealthCheck || exit 1

# Comando de ejecución
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
